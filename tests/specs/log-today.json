[
  {
    "name": "Log Today's Habits",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "You’re not in a family yet — ask a parent for the join link."
            }
          }
        ],
        "send": {
          "callback": "log:today"
        }
      }
    ]
  }
  ,
  {
    "name": "A member can cancel a media check-in",
    "steps": [
      {
        "send": { "callback": "check:cancel" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "No check-in was saved. Tap Log today whenever you’re ready." }
          }
        ]
      }
    ]
  }
]
